# ============================================================
# 开箱 OpenBox · 后端环境变量
# 复制本文件为 .env 后按需修改。真实 .env 已被 .gitignore 忽略。
# ============================================================

# 监听端口与地址
# 只在本机访问用 127.0.0.1；想让局域网内其他设备（手机）访问改成 0.0.0.0
PORT=8788
HOST=127.0.0.1

# 运行环境：development | production
# production 下会强制校验 ADMIN_PASSWORD 与 SESSION_SECRET 必须显式设置
NODE_ENV=development

# 后台管理密码。留空则首次启动自动生成一个随机密码并打印到启动日志，
# 之后密码哈希会持久化到数据库，重启不变。
# production 下必须显式设置。
ADMIN_PASSWORD=

# 会话签名密钥（至少 32 字符）。留空则首次启动自动生成并持久化到数据库。
SESSION_SECRET=

# 会话有效期（小时）
SESSION_TTL_HOURS=12

# 允许的来源，逗号分隔。留空表示只允许同源访问（推荐）。
# 示例：ALLOWED_ORIGINS=https://abc.example.com,http://127.0.0.1:8788
ALLOWED_ORIGINS=

# 数据目录（SQLite 文件所在位置），相对路径以项目根为基准
DATA_DIR=./data

# 日志级别：debug | info | warn | error
LOG_LEVEL=info

# 防刷限制：同一 IP 在窗口期内的下单尝试次数上限与窗口秒数
# 注意：校验失败的请求也计入次数，防止有人用无效请求刷接口。
# 真实用户一次只会提交一单，20 次足够宽松；若要更严可下调。
ORDER_RATE_MAX=20
ORDER_RATE_WINDOW_SEC=600

# 防爆破：同一 IP 在窗口期内的登录尝试次数上限与窗口秒数
LOGIN_RATE_MAX=10
LOGIN_RATE_WINDOW_SEC=600

# 反向代理层数（部署在 Nginx / CDN 后面时用于取真实客户端 IP）。直连填 0
TRUST_PROXY_HOPS=0

# 内测横幅：on 时落地页顶部显示一条提示，让测试者知道这是试用版、问题找谁。
# 正式对外前改成 off 即可，不需要改 HTML。文案由 BETA_NOTE 控制。
BETA_MODE=off
BETA_NOTE=内测版 · 服务还在打磨，有问题请联系我们
